{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/guidebook-preparedness",
  "version": "0.1.0",
  "description": "The preparedness content of the guidebook: cited US public-domain sources, and the steps and marked gaps of 12 cases and 6 cuts, for each phase.",
  "keywords": [
    "guidebook",
    "preparedness",
    "emergency",
    "plan",
    "steps",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/guidebook#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/guidebook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/guidebook.git",
    "directory": "packages/preparedness"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "data",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "tsdown": "^0.23.7",
    "@mark1russell7/ste-lint": "^0.4.0"
  },
  "dependencies": {
    "@mark1russell7/guidebook": "workspace:*",
    "@mark1russell7/guidebook-plans": "workspace:*"
  }
}
