{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/guidebook",
  "version": "0.8.0",
  "description": "The core of a guidebook of cited knowledge: sources with their licenses, cited units (a quote, a summary or a fact) and the source gate. The core names no topic.",
  "keywords": [
    "guidebook",
    "citation",
    "license",
    "source",
    "creative-commons",
    "public-domain",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/guidebook#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/guidebook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/guidebook.git",
    "directory": "packages/guidebook"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mark1russell7/text": "^0.0.21"
  }
}
