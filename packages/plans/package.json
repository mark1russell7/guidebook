{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/guidebook-plans",
  "version": "0.3.10",
  "description": "The plans add-on of the guidebook: a time ladder of phases, steps keyed by a case or a cut and a phase, the steps query, the matrix of a library with its marked gaps, and the step gate.",
  "keywords": [
    "guidebook",
    "plan",
    "runbook",
    "steps",
    "phases",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/guidebook#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/guidebook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/guidebook.git",
    "directory": "packages/plans"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "tsdown": "^0.23.7"
  },
  "dependencies": {
    "@mark1russell7/collections": "^0.11.3",
    "@mark1russell7/guidebook": "workspace:*"
  }
}
