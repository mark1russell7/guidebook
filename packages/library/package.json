{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/guidebook-library",
  "version": "0.4.0",
  "description": "The library add-on of the guidebook: a catalog of offline bundles (size, license, version, checksum), the copies of each bundle on media, and the gaps of the copies of each level.",
  "keywords": [
    "guidebook",
    "offline",
    "library",
    "kiwix",
    "zim",
    "backup",
    "redundancy",
    "checksum",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/guidebook#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/guidebook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/guidebook.git",
    "directory": "packages/library"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/guidebook": "workspace:*",
    "@mark1russell7/stack-placement": "^0.1.1",
    "@mark1russell7/stack-risk": "^0.2.1",
    "@mark1russell7/system-stack": "^0.1.6",
    "@mark1russell7/text": "^0.0.19"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "tsdown": "^0.23.7"
  }
}
