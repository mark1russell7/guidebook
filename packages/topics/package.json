{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/guidebook-topics",
  "version": "0.1.3",
  "description": "The topics add-on of the guidebook: topics as a graph of prerequisites, the graph gate (no cycle, no unknown topic, unit or bundle) and the print order. The add-on names no topic.",
  "keywords": [
    "guidebook",
    "topics",
    "prerequisites",
    "dag",
    "curriculum",
    "knowledge-graph",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/guidebook#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/guidebook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/guidebook.git",
    "directory": "packages/topics"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/collections": "^0.11.3",
    "@mark1russell7/guidebook": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "tsdown": "^0.23.7"
  }
}
